<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WOLO Real Estate Chatbot</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Glassmorphism scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.3);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.2);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(99, 102, 241, 0.4);
        }
        /* Custom typing animation */
        .dot {
            animation: wave 1.3s linear infinite;
        }
        .dot:nth-child(2) { animation-delay: -1.1s; }
        .dot:nth-child(3) { animation-delay: -0.9s; }
        @keyframes wave {
            0%, 60%, 100% { transform: translateY(0); }
            30% { transform: translateY(-4px); }
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-950/40 via-slate-950 to-slate-950">

    <!-- Header -->
    <header class="border-b border-slate-900 bg-slate-950/60 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-violet-600 to-indigo-600 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                    <span class="font-bold text-white text-lg tracking-wider">W</span>
                </div>
                <div>
                    <h1 class="text-lg font-bold bg-clip-text text-transparent bg-gradient-to-r from-violet-400 to-indigo-300">WOLO Real Estate</h1>
                    <p class="text-xs text-slate-500 flex items-center">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 mr-1.5 animate-pulse"></span>
                        AI Agent Online
                    </p>
                </div>
            </div>
            <div class="text-xs text-slate-500">
                Microservices Demo
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 py-6 flex flex-col md:flex-row gap-6 overflow-hidden">
        
        <!-- Sidebar Info -->
        <section class="w-full md:w-80 flex-shrink-0 bg-slate-900/40 border border-slate-900 rounded-2xl p-5 flex flex-col gap-4 backdrop-blur-sm">
            <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wider">About WOLO</h2>
            <p class="text-sm text-slate-400 leading-relaxed">
                WOLO is an AI-powered conversational agent that helps you find properties to rent or buy. Ask natural questions, explore listings, and schedule visits instantly.
            </p>
            <hr class="border-slate-900">
            <h3 class="text-xs font-semibold text-slate-500 uppercase">Try Asking:</h3>
            <div class="flex flex-col gap-2">
                <button onclick="fillMessage('I am looking for a flat to rent in Barcelona')" class="text-left text-xs bg-slate-950/60 hover:bg-slate-900/60 border border-slate-900 hover:border-indigo-500/30 text-slate-300 px-3 py-2 rounded-xl transition duration-200">
                    "I am looking for a flat to rent in Barcelona"
                </button>
                <button onclick="fillMessage('Do you have anything for rent under 1500€?')" class="text-left text-xs bg-slate-950/60 hover:bg-slate-900/60 border border-slate-900 hover:border-indigo-500/30 text-slate-300 px-3 py-2 rounded-xl transition duration-200">
                    "Do you have anything for rent under 1500€?"
                </button>
                <button onclick="fillMessage('I want to buy a penthouse in Madrid')" class="text-left text-xs bg-slate-950/60 hover:bg-slate-900/60 border border-slate-900 hover:border-indigo-500/30 text-slate-300 px-3 py-2 rounded-xl transition duration-200">
                    "I want to buy a penthouse in Madrid"
                </button>
            </div>
        </section>

        <!-- Chat Panel -->
        <section class="flex-1 bg-slate-900/20 border border-slate-900 rounded-2xl flex flex-col overflow-hidden backdrop-blur-sm relative">
            
            <!-- Messages Box -->
            <div id="chat-container" class="flex-1 overflow-y-auto p-6 space-y-4 flex flex-col">
                <!-- System/Bot Initial Message -->
                <div class="flex items-start space-x-3 max-w-[85%] self-start">
                    <div class="h-8 w-8 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center flex-shrink-0">
                        🤖
                    </div>
                    <div class="bg-slate-900/80 text-slate-100 rounded-2xl rounded-tl-none px-4 py-3 shadow-md border border-slate-800/80">
                        <p class="text-sm leading-relaxed">Hello! I am your WOLO Assistant. How can I help you find your dream property today?</p>
                    </div>
                </div>
            </div>

            <!-- Typing/Loading Indicator -->
            <div id="typing-indicator" class="hidden px-6 py-3 items-center space-x-3 max-w-[85%] self-start">
                <div class="h-8 w-8 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center flex-shrink-0">
                    🤖
                </div>
                <div class="bg-slate-900/40 text-slate-400 rounded-2xl rounded-tl-none px-4 py-3 border border-slate-900 flex items-center space-x-1">
                    <span class="dot h-1.5 w-1.5 bg-slate-500 rounded-full"></span>
                    <span class="dot h-1.5 w-1.5 bg-slate-500 rounded-full"></span>
                    <span class="dot h-1.5 w-1.5 bg-slate-500 rounded-full"></span>
                </div>
            </div>

            <!-- Input area -->
            <div class="p-4 border-t border-slate-900 bg-slate-950/40">
                <form id="chat-form" class="flex items-center space-x-3">
                    <input type="text" id="message-input" autocomplete="off" placeholder="Ask WOLO about properties..." class="flex-1 bg-slate-950/60 border border-slate-800 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500/20 text-slate-100 text-sm px-4 py-3 rounded-xl outline-none placeholder-slate-600 transition duration-200">
                    <button type="submit" id="send-button" class="bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white text-sm font-semibold px-5 py-3 rounded-xl transition duration-200 shadow-md shadow-indigo-600/10 flex items-center justify-center space-x-1.5">
                        <span>Send</span>
                        <svg class="h-4 w-4 transform rotate-90" viewBox="0 0 20 20" fill="currentColor"><path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/></svg>
                    </button>
                </form>
            </div>
        </section>
    </main>

    <!-- Lead Capture Modal Overlay -->
    <div id="lead-modal" class="fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl w-full max-w-md mx-4 shadow-2xl relative transform scale-95 transition-transform duration-300">
            <!-- Close Button -->
            <button onclick="closeModal()" class="absolute top-4 right-4 text-slate-500 hover:text-slate-200 transition">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            <h3 class="text-lg font-bold text-slate-100 mb-2">Register Your Interest</h3>
            <p class="text-xs text-slate-400 mb-4">Provide your contact details so our real estate agent can coordinate a visit with you.</p>
            
            <form id="lead-form" class="space-y-4">
                <input type="hidden" id="modal-property-id">
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1" for="lead-name">Full Name</label>
                    <input type="text" id="lead-name" required class="w-full bg-slate-950/60 border border-slate-800 focus:border-indigo-500 text-slate-100 text-sm px-3.5 py-2.5 rounded-xl outline-none transition duration-200">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1" for="lead-email">Email Address</label>
                    <input type="email" id="lead-email" required class="w-full bg-slate-950/60 border border-slate-800 focus:border-indigo-500 text-slate-100 text-sm px-3.5 py-2.5 rounded-xl outline-none transition duration-200">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1" for="lead-phone">Phone Number (Optional)</label>
                    <input type="text" id="lead-phone" class="w-full bg-slate-950/60 border border-slate-800 focus:border-indigo-500 text-slate-100 text-sm px-3.5 py-2.5 rounded-xl outline-none transition duration-200">
                </div>
                <div class="pt-2">
                    <button type="submit" id="submit-lead-button" class="w-full bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white text-sm font-semibold py-3 rounded-xl transition duration-200 shadow-lg shadow-indigo-600/10">
                        Submit Request
                    </button>
                </div>
            </form>

            <!-- Success Overlay inside modal -->
            <div id="modal-success" class="absolute inset-0 bg-slate-900 rounded-2xl flex flex-col items-center justify-center hidden">
                <div class="h-14 w-14 rounded-full bg-emerald-500/10 text-emerald-500 flex items-center justify-center mb-3">
                    <svg class="h-8 w-8 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                </div>
                <h4 class="text-md font-bold text-slate-100">Interest Registered!</h4>
                <p class="text-xs text-slate-400 mt-1">An agent will contact you shortly.</p>
            </div>
        </div>
    </div>

    <!-- Client-side Javascript -->
    <script>
        const chatForm = document.getElementById('chat-form');
        const messageInput = document.getElementById('message-input');
        const chatContainer = document.getElementById('chat-container');
        const typingIndicator = document.getElementById('typing-indicator');
        
        // Generate a random session ID for this browser tab
        const sessionId = 'session_' + Math.random().toString(36).substring(2, 11);
        
        // Lead service target URL injected by template (falls back to static staging URL)
        const leadServiceUrl = "{{ leadServiceUrl|default('https://lead-service-aevnltclea-ew.a.run.app') }}";

        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = messageInput.value.trim();
            if (!text) return;

            // Append User Message to UI
            appendUserMessage(text);
            messageInput.value = '';

            // Show Typing Indicator
            showTyping(true);

            try {
                // Call /api/chat endpoint
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId, message: text })
                });

                const data = await response.json();
                showTyping(false);

                if (data.response) {
                    appendBotMessage(data.response);
                } else if (data.error) {
                    appendBotMessage(`Error: ${data.error}`);
                }

                // If property search results are returned, render them as cards
                if (data.properties && Array.isArray(data.properties) && data.properties.length > 0) {
                    appendPropertyCards(data.properties);
                }
            } catch (err) {
                showTyping(false);
                appendBotMessage('Sorry, I encountered a communication error with the orchestrator. Please try again.');
            }
        });

        function fillMessage(text) {
            messageInput.value = text;
            messageInput.focus();
        }

        function appendUserMessage(text) {
            const msgHtml = `
                <div class="flex items-start space-x-3 max-w-[85%] self-end">
                    <div class="bg-gradient-to-r from-violet-600 to-indigo-600 text-white rounded-2xl rounded-tr-none px-4 py-3 shadow-md">
                        <p class="text-sm leading-relaxed">${escapeHtml(text)}</p>
                    </div>
                </div>
            `;
            chatContainer.insertAdjacentHTML('beforeend', msgHtml);
            scrollToBottom();
        }

        function appendBotMessage(text) {
            const msgHtml = `
                <div class="flex items-start space-x-3 max-w-[85%] self-start">
                    <div class="h-8 w-8 rounded-lg bg-slate-800 border border-slate-700 flex items-center justify-center flex-shrink-0">
                        🤖
                    </div>
                    <div class="bg-slate-900/80 text-slate-100 rounded-2xl rounded-tl-none px-4 py-3 shadow-md border border-slate-800/80">
                        <p class="text-sm leading-relaxed">${escapeHtml(text)}</p>
                    </div>
                </div>
            `;
            chatContainer.insertAdjacentHTML('beforeend', msgHtml);
            scrollToBottom();
        }

        function appendPropertyCards(properties) {
            let cardsHtml = `
                <div class="w-full pl-11 flex flex-col gap-3">
                    <p class="text-xs text-slate-500 font-semibold uppercase tracking-wider mb-1">Matching Listings:</p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            `;

            properties.forEach(prop => {
                const title = prop.title || 'Cozy Apartment';
                const price = prop.price ? new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(prop.price) : 'Contact Agent';
                const location = prop.location || 'Unknown';
                const bedrooms = prop.bedrooms || 1;
                const type = prop.type || 'rent';
                const id = prop.id || Math.floor(Math.random() * 100);

                cardsHtml += `
                    <div class="bg-slate-900/40 border border-slate-800/80 rounded-xl overflow-hidden hover:border-indigo-500/50 transition duration-300 shadow-md group flex flex-col">
                        <div class="h-32 bg-slate-800 flex items-center justify-center text-slate-500 relative flex-shrink-0">
                            <!-- Background color block to simulate visual content card -->
                            <div class="absolute inset-0 bg-gradient-to-tr from-violet-950/20 to-indigo-950/20 group-hover:opacity-80 transition duration-300"></div>
                            🏠 WOLO Property View
                            <span class="absolute top-2 right-2 text-[10px] font-bold tracking-wider uppercase bg-indigo-600/90 text-white px-2 py-0.5 rounded-full">${type}</span>
                        </div>
                        <div class="p-4 flex-1 flex flex-col justify-between">
                            <div>
                                <h4 class="text-sm font-bold text-slate-200 line-clamp-1">${escapeHtml(title)}</h4>
                                <p class="text-xs text-slate-500 flex items-center mt-1">
                                    📍 ${escapeHtml(location)}
                                </p>
                                <div class="flex items-center gap-3 mt-3 text-xs text-slate-400">
                                    <span>🛏️ ${bedrooms} Bed${bedrooms > 1 ? 's' : ''}</span>
                                    <span>•</span>
                                    <span class="font-bold text-indigo-400 text-sm">${price}${type === 'rent' ? '/mo' : ''}</span>
                                </div>
                            </div>
                            <div class="mt-4">
                                <button onclick="openModal(${id})" class="w-full text-center bg-indigo-600/10 hover:bg-indigo-600 border border-indigo-500/30 hover:border-indigo-500 text-indigo-400 hover:text-white text-xs font-semibold py-2 rounded-lg transition duration-200">
                                    Register Interest
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            });

            cardsHtml += `
                    </div>
                </div>
            `;
            chatContainer.insertAdjacentHTML('beforeend', cardsHtml);
            scrollToBottom();
        }

        function showTyping(show) {
            if (show) {
                typingIndicator.classList.remove('hidden');
                typingIndicator.classList.add('flex');
            } else {
                typingIndicator.classList.add('hidden');
                typingIndicator.classList.remove('flex');
            }
            scrollToBottom();
        }

        function scrollToBottom() {
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        function escapeHtml(str) {
            if (typeof str !== 'string') return '';
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // Modal Logic
        const modal = document.getElementById('lead-modal');
        const modalInner = modal.querySelector('.transform');
        const leadForm = document.getElementById('lead-form');
        const modalSuccess = document.getElementById('modal-success');

        function openModal(propertyId) {
            document.getElementById('modal-property-id').value = propertyId;
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalInner.classList.remove('scale-95');
            }, 10);
        }

        function closeModal() {
            modal.classList.add('opacity-0');
            modalInner.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
                modalSuccess.classList.add('hidden');
                leadForm.reset();
            }, 300);
        }

        leadForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const propertyId = parseInt(document.getElementById('modal-property-id').value);
            const name = document.getElementById('lead-name').value.trim();
            const email = document.getElementById('lead-email').value.trim();
            const phone = document.getElementById('lead-phone').value.trim();

            const submitBtn = document.getElementById('submit-lead-button');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';

            try {
                // POST to lead service api endpoint
                const response = await fetch(`${leadServiceUrl}/api/leads`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, email, phone, propertyId })
                });

                if (response.ok) {
                    // Show success checkmark inside modal
                    modalSuccess.classList.remove('hidden');
                    setTimeout(() => {
                        closeModal();
                    }, 2200);
                } else {
                    const errData = await response.json();
                    alert(`Failed to register interest: ${JSON.stringify(errData.errors || errData.error)}`);
                }
            } catch (err) {
                alert('Connection to Lead & Notification Service failed. Staging database event mocked locally.');
                modalSuccess.classList.remove('hidden');
                setTimeout(() => {
                    closeModal();
                }, 2200);
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Submit Request';
            }
        });
    </script>
</body>
</html>
