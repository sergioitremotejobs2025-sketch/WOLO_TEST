<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Browse Properties - WOLO Real Estate</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        h1, h2, h3, h4, .font-heading {
            font-family: 'Outfit', sans-serif;
        }
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.3);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(99, 102, 241, 0.2);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(99, 102, 241, 0.4);
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-950/40 via-slate-950 to-slate-950">

    <!-- Header -->
    <header class="border-b border-slate-900 bg-slate-950/60 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <a href="/properties" class="flex items-center space-x-3">
                    <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-violet-600 to-indigo-600 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                        <span class="font-bold text-white text-lg tracking-wider">W</span>
                    </div>
                    <div>
                        <h1 class="text-lg font-bold bg-clip-text text-transparent bg-gradient-to-r from-violet-400 to-indigo-300">WOLO Real Estate</h1>
                        <p class="text-xs text-slate-500">Property Catalog Service</p>
                    </div>
                </a>
            </div>
            <div class="flex items-center space-x-3">
                <button onclick="openCreateModal()" class="text-xs font-semibold bg-violet-600 hover:bg-violet-500 text-white px-4 py-2 rounded-xl transition duration-200 shadow-md">
                    + Add Property
                </button>
                <a href="https://chat-orchestrator-aevnltclea-ew.a.run.app/chat" class="text-xs font-semibold bg-indigo-600/20 hover:bg-indigo-600 border border-indigo-500/30 hover:border-indigo-500 text-indigo-300 hover:text-white px-4 py-2 rounded-xl transition duration-200 shadow-md">
                    💬 Chat with Assistant
                </a>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 py-8 flex flex-col gap-6">
        
        <!-- Welcome Section -->
        <section class="mb-2">
            <h1 class="text-3xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-white via-slate-200 to-slate-400 mb-2">Browse Properties</h1>
            <p class="text-slate-400 text-sm max-w-2xl">Discover rental apartments and properties for sale. Use the search filters to narrow down by location, type, and price range.</p>
        </section>

        <!-- Filters Section -->
        <section class="bg-slate-900/40 border border-slate-900 rounded-2xl p-6 backdrop-blur-sm shadow-xl">
            <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-4 flex items-center">
                <svg class="h-4 w-4 mr-2 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 8.293A1 1 0 013 7.586V4z"/></svg>
                Filter Listings
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-2" for="filter-city">City / Location</label>
                    <input type="text" id="filter-city" placeholder="e.g. Barcelona" class="w-full bg-slate-950/60 border border-slate-800 focus:border-indigo-500 text-slate-100 text-sm px-4 py-3 rounded-xl outline-none placeholder-slate-600 transition duration-200">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-2" for="filter-type">Listing Type</label>
                    <select id="filter-type" class="w-full bg-slate-950/60 border border-slate-800 focus:border-indigo-500 text-slate-100 text-sm px-4 py-3 rounded-xl outline-none transition duration-200">
                        <option value="">All Types</option>
                        <option value="rent">To Rent</option>
                        <option value="buy">To Buy</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-2" for="filter-price-max">Maximum Price (€)</label>
                    <input type="number" id="filter-price-max" placeholder="e.g. 1500" class="w-full bg-slate-950/60 border border-slate-800 focus:border-indigo-500 text-slate-100 text-sm px-4 py-3 rounded-xl outline-none placeholder-slate-600 transition duration-200">
                </div>
                <div>
                    <button id="btn-reset" class="w-full bg-slate-950/60 hover:bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-300 text-sm font-semibold py-3 rounded-xl transition duration-200 shadow-md">
                        Reset Filters
                    </button>
                </div>
            </div>
        </section>

        <!-- Properties Grid Section -->
        <section>
            <div id="property-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Initial properties loaded serverside -->
                {% for property in properties %}
                    <div class="bg-slate-900/40 border border-slate-900 rounded-2xl overflow-hidden hover:border-indigo-500/50 transition duration-300 shadow-lg group flex flex-col cursor-pointer" onclick="openDetailsModal({{ property.id }}, '{{ property.title|escape('js') }}', {{ property.price }}, '{{ property.type|escape('js') }}', {{ property.bedrooms }}, '{{ property.location|escape('js') }}')">
                        <div class="h-44 bg-slate-900 flex items-center justify-center text-slate-600 relative">
                            <div class="absolute inset-0 bg-gradient-to-tr from-violet-950/20 to-indigo-950/20 group-hover:opacity-80 transition duration-300"></div>
                            <span class="text-4xl group-hover:scale-110 transition duration-300">🏠</span>
                            <span class="absolute top-4 right-4 text-xs font-bold tracking-wider uppercase bg-indigo-600 text-white px-2.5 py-1 rounded-full shadow-md">{{ property.type }}</span>
                        </div>
                        <div class="p-6 flex-1 flex flex-col justify-between">
                            <div>
                                <h3 class="text-md font-bold text-slate-200 group-hover:text-indigo-400 transition duration-200 line-clamp-1">{{ property.title }}</h3>
                                <p class="text-xs text-slate-500 flex items-center mt-1.5">
                                    <svg class="h-3.5 w-3.5 mr-1 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                    {{ property.location }}
                                </p>
                                <div class="flex items-center gap-3 mt-4 text-xs text-slate-400">
                                    <span class="bg-slate-950/40 px-2.5 py-1 rounded-lg border border-slate-900 flex items-center">🛏️ {{ property.bedrooms }} Bed{{ property.bedrooms > 1 ? 's' : '' }}</span>
                                    <span class="font-bold text-indigo-400 text-base ml-auto">{{ property.price|number_format(0, ',', '.') }} €{{ property.type == 'rent' ? '/mo' : '' }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-span-full py-12 text-center text-slate-500">
                        No properties found in the catalog.
                    </div>
                {% endfor %}
            </div>
        </section>
    </main>

    <!-- Details Modal Overlay -->
    <div id="details-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl w-full max-w-lg mx-4 shadow-2xl relative transform scale-95 transition-transform duration-300">
            <!-- Close Button -->
            <button onclick="closeDetailsModal()" class="absolute top-4 right-4 text-slate-500 hover:text-slate-200 transition">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            
            <div class="h-48 bg-slate-950/60 rounded-xl flex items-center justify-center text-slate-600 mb-6 relative">
                <div class="absolute inset-0 bg-gradient-to-tr from-violet-950/20 to-indigo-950/20"></div>
                <span class="text-6xl">🏠</span>
                <span id="modal-type" class="absolute top-4 right-4 text-xs font-bold tracking-wider uppercase bg-indigo-600 text-white px-2.5 py-1 rounded-full shadow-md">RENT</span>
            </div>

            <h3 id="modal-title" class="text-xl font-bold text-slate-100 mb-1">Property Title</h3>
            <p id="modal-location" class="text-sm text-slate-400 flex items-center mb-4">
                📍 Location
            </p>
            
            <hr class="border-slate-800 mb-4">
            
            <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="bg-slate-950/40 p-3.5 rounded-xl border border-slate-900">
                    <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold mb-1">Bedrooms</p>
                    <p id="modal-bedrooms" class="text-sm font-bold text-slate-200">2 Bedrooms</p>
                </div>
                <div class="bg-slate-950/40 p-3.5 rounded-xl border border-slate-900">
                    <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold mb-1">Listed Price</p>
                    <p id="modal-price" class="text-sm font-bold text-indigo-400">1.200 €</p>
                </div>
            </div>

            <div class="flex gap-4">
                <button onclick="closeDetailsModal()" class="flex-1 bg-slate-950/60 hover:bg-slate-900 border border-slate-800 text-slate-300 text-sm font-semibold py-3.5 rounded-xl transition duration-200">
                    Close Window
                </button>
                <a id="modal-chat-cta" href="https://chat-orchestrator-aevnltclea-ew.a.run.app/chat" class="flex-1 bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white text-sm font-semibold py-3.5 rounded-xl transition duration-200 text-center shadow-lg shadow-indigo-600/10">
                    Ask WOLO Assistant
                </a>
            </div>
        </div>
    </div>

    <!-- Add Property Modal Overlay -->
    <div id="create-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-300">
        <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl w-full max-w-lg mx-4 shadow-2xl relative transform scale-95 transition-transform duration-300">
            <!-- Close Button -->
            <button onclick="closeCreateModal()" class="absolute top-4 right-4 text-slate-500 hover:text-slate-200 transition">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
            
            <h3 class="text-xl font-bold text-slate-100 mb-2 font-heading">Add New Property</h3>
            <p class="text-xs text-slate-400 mb-4">Fill in the details below to add a property listing to the catalog.</p>
            
            <form id="create-form" class="space-y-4">
                <div id="create-errors" class="hidden text-xs bg-red-500/10 border border-red-500/20 text-red-400 p-3 rounded-xl">
                </div>
                
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1" for="create-title">Property Title</label>
                    <input type="text" id="create-title" required placeholder="e.g. Modern Apartment in Eixample" class="w-full bg-slate-950/60 border border-slate-800 focus:border-indigo-500 text-slate-100 text-sm px-3.5 py-2.5 rounded-xl outline-none transition duration-200">
                </div>
                
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1" for="create-location">City / Location</label>
                    <input type="text" id="create-location" required placeholder="e.g. Barcelona" class="w-full bg-slate-950/60 border border-slate-800 focus:border-indigo-500 text-slate-100 text-sm px-3.5 py-2.5 rounded-xl outline-none transition duration-200">
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 mb-1" for="create-type">Listing Type</label>
                        <select id="create-type" required class="w-full bg-slate-950/60 border border-slate-800 focus:border-indigo-500 text-slate-100 text-sm px-3.5 py-2.5 rounded-xl outline-none transition duration-200">
                            <option value="rent">To Rent</option>
                            <option value="buy">To Buy</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 mb-1" for="create-price">Price (€)</label>
                        <input type="number" id="create-price" required placeholder="1200" class="w-full bg-slate-950/60 border border-slate-800 focus:border-indigo-500 text-slate-100 text-sm px-3.5 py-2.5 rounded-xl outline-none transition duration-200">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 mb-1" for="create-bedrooms">Bedrooms</label>
                        <input type="number" id="create-bedrooms" required placeholder="2" class="w-full bg-slate-950/60 border border-slate-800 focus:border-indigo-500 text-slate-100 text-sm px-3.5 py-2.5 rounded-xl outline-none transition duration-200">
                    </div>
                </div>

                <div class="pt-4 flex gap-4">
                    <button type="button" onclick="closeCreateModal()" class="flex-1 bg-slate-950/60 hover:bg-slate-900 border border-slate-800 text-slate-300 text-sm font-semibold py-3 rounded-xl transition duration-200">
                        Cancel
                    </button>
                    <button type="submit" id="btn-submit-create" class="flex-1 bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white text-sm font-semibold py-3 rounded-xl transition duration-200 shadow-lg shadow-indigo-600/10">
                        Save Property
                    </button>
                </div>
            </form>

            <!-- Success Overlay inside modal -->
            <div id="create-success" class="absolute inset-0 bg-slate-900 rounded-2xl flex flex-col items-center justify-center hidden">
                <div class="h-14 w-14 rounded-full bg-emerald-500/10 text-emerald-500 flex items-center justify-center mb-3">
                    <svg class="h-8 w-8 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                </div>
                <h4 class="text-md font-bold text-slate-100">Property Added!</h4>
                <p class="text-xs text-slate-400 mt-1">Listing has been successfully added.</p>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-slate-900 bg-slate-950/40 py-6 text-center text-xs text-slate-600 mt-auto">
        &copy; 2026 WOLO Real Estate. All rights reserved.
    </footer>

    <!-- Client-side Javascript -->
    <script>
        const filterCity = document.getElementById('filter-city');
        const filterType = document.getElementById('filter-type');
        const filterPriceMax = document.getElementById('filter-price-max');
        const btnReset = document.getElementById('btn-reset');
        const propertyGrid = document.getElementById('property-grid');

        // Dynamic Filtering
        async function fetchFilteredProperties() {
            const city = filterCity.value.trim();
            const type = filterType.value;
            const priceMax = filterPriceMax.value;

            // Build query params
            const params = new URLSearchParams();
            if (city) params.append('city', city);
            if (type) params.append('type', type);
            if (priceMax) params.append('price_max', priceMax);

            try {
                const response = await fetch(`/api/properties?${params.toString()}`);
                if (!response.ok) throw new Error('API request failed');
                
                const data = await response.json();
                renderProperties(data);
            } catch (err) {
                console.error('Error fetching properties:', err);
                propertyGrid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-red-400">
                        Error fetching properties. Please try again.
                    </div>
                `;
            }
        }

        function renderProperties(properties) {
            if (properties.length === 0) {
                propertyGrid.innerHTML = `
                    <div class="col-span-full py-12 text-center text-slate-500">
                        No properties found matching your criteria.
                    </div>
                `;
                return;
            }

            let gridHtml = '';
            properties.forEach(prop => {
                const title = prop.title || 'Cozy Apartment';
                const priceVal = prop.price || 0;
                const price = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(priceVal);
                const location = prop.location || 'Unknown';
                const bedrooms = prop.bedrooms || 1;
                const type = prop.type || 'rent';
                const id = prop.id;

                const escapedTitle = escapeHtml(title);
                const escapedType = escapeHtml(type);
                const escapedLocation = escapeHtml(location);

                gridHtml += `
                    <div class="bg-slate-900/40 border border-slate-900 rounded-2xl overflow-hidden hover:border-indigo-500/50 transition duration-300 shadow-lg group flex flex-col cursor-pointer" onclick="openDetailsModal(${id}, '${escapedTitle.replace(/'/g, "\\'")}', ${priceVal}, '${escapedType.replace(/'/g, "\\'")}', ${bedrooms}, '${escapedLocation.replace(/'/g, "\\'")}')">
                        <div class="h-44 bg-slate-900 flex items-center justify-center text-slate-600 relative">
                            <div class="absolute inset-0 bg-gradient-to-tr from-violet-950/20 to-indigo-950/20 group-hover:opacity-80 transition duration-300"></div>
                            <span class="text-4xl group-hover:scale-110 transition duration-300">🏠</span>
                            <span class="absolute top-4 right-4 text-xs font-bold tracking-wider uppercase bg-indigo-600 text-white px-2.5 py-1 rounded-full shadow-md">${escapedType}</span>
                        </div>
                        <div class="p-6 flex-1 flex flex-col justify-between">
                            <div>
                                <h3 class="text-md font-bold text-slate-200 group-hover:text-indigo-400 transition duration-200 line-clamp-1">${escapedTitle}</h3>
                                <p class="text-xs text-slate-500 flex items-center mt-1.5">
                                    <svg class="h-3.5 w-3.5 mr-1 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                    ${escapedLocation}
                                </p>
                                <div class="flex items-center gap-3 mt-4 text-xs text-slate-400">
                                    <span class="bg-slate-950/40 px-2.5 py-1 rounded-lg border border-slate-900 flex items-center">🛏️ ${bedrooms} Bed${bedrooms > 1 ? 's' : ''}</span>
                                    <span class="font-bold text-indigo-400 text-base ml-auto">${price}${type === 'rent' ? '/mo' : ''}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            });

            propertyGrid.innerHTML = gridHtml;
        }

        // Debounce helper
        let debounceTimeout;
        function debounce(func, delay = 300) {
            return (...args) => {
                clearTimeout(debounceTimeout);
                debounceTimeout = setTimeout(() => func(...args), delay);
            };
        }

        // Event Listeners
        filterCity.addEventListener('input', debounce(fetchFilteredProperties, 300));
        filterType.addEventListener('change', fetchFilteredProperties);
        filterPriceMax.addEventListener('input', debounce(fetchFilteredProperties, 300));

        btnReset.addEventListener('click', () => {
            filterCity.value = '';
            filterType.value = '';
            filterPriceMax.value = '';
            fetchFilteredProperties();
        });

        // Details Modal Logic
        const modal = document.getElementById('details-modal');
        const modalInner = modal.querySelector('.transform');
        const modalTitle = document.getElementById('modal-title');
        const modalLocation = document.getElementById('modal-location');
        const modalType = document.getElementById('modal-type');
        const modalBedrooms = document.getElementById('modal-bedrooms');
        const modalPrice = document.getElementById('modal-price');
        const modalChatCta = document.getElementById('modal-chat-cta');

        function openDetailsModal(id, title, price, type, bedrooms, location) {
            modalTitle.textContent = title;
            modalLocation.innerHTML = `📍 ${location}`;
            modalType.textContent = type;
            modalBedrooms.textContent = `${bedrooms} Bedroom${bedrooms > 1 ? 's' : ''}`;
            
            const formattedPrice = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(price);
            modalPrice.textContent = `${formattedPrice}${type === 'rent' ? '/mo' : ''}`;
            
            // Prefill query in chat orchestrator CTA
            const prefilledMessage = encodeURIComponent(`Tell me more about property: "${title}" in ${location}`);
            modalChatCta.href = `https://chat-orchestrator-aevnltclea-ew.a.run.app/chat?message=${prefilledMessage}`;

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalInner.classList.remove('scale-95');
            }, 10);
        }

        function closeDetailsModal() {
            modal.classList.add('opacity-0');
            modalInner.classList.add('scale-95');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        // Create Modal Logic
        const createModal = document.getElementById('create-modal');
        const createModalInner = createModal.querySelector('.transform');
        const createForm = document.getElementById('create-form');
        const createErrors = document.getElementById('create-errors');
        const createSuccess = document.getElementById('create-success');

        function openCreateModal() {
            createModal.classList.remove('hidden');
            setTimeout(() => {
                createModal.classList.remove('opacity-0');
                createModalInner.classList.remove('scale-95');
            }, 10);
        }

        function closeCreateModal() {
            createModal.classList.add('opacity-0');
            createModalInner.classList.add('scale-95');
            setTimeout(() => {
                createModal.classList.add('hidden');
                createSuccess.classList.add('hidden');
                createErrors.classList.add('hidden');
                createForm.reset();
            }, 300);
        }

        createForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            createErrors.classList.add('hidden');
            createErrors.innerHTML = '';

            const title = document.getElementById('create-title').value.trim();
            const location = document.getElementById('create-location').value.trim();
            const type = document.getElementById('create-type').value;
            const price = parseFloat(document.getElementById('create-price').value);
            const bedrooms = parseInt(document.getElementById('create-bedrooms').value);

            const submitBtn = document.getElementById('btn-submit-create');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Saving...';

            try {
                const response = await fetch('/api/properties', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title, location, type, price, bedrooms })
                });

                if (response.ok) {
                    createSuccess.classList.remove('hidden');
                    // Refresh listing grid
                    await fetchFilteredProperties();
                    setTimeout(() => {
                        closeCreateModal();
                    }, 1500);
                } else {
                    const errData = await response.json();
                    let errMsg = '<strong>Please correct the following errors:</strong><ul class="list-disc pl-4 mt-1">';
                    if (errData.errors) {
                        for (const field in errData.errors) {
                            errMsg += `<li>${escapeHtml(errData.errors[field])}</li>`;
                        }
                    } else {
                        errMsg += `<li>${escapeHtml(errData.error || 'Unknown error occurred')}</li>`;
                    }
                    errMsg += '</ul>';
                    createErrors.innerHTML = errMsg;
                    createErrors.classList.remove('hidden');
                }
            } catch (err) {
                createErrors.innerHTML = 'Connection to Property Service failed. Please try again.';
                createErrors.classList.remove('hidden');
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Save Property';
            }
        });

        function escapeHtml(str) {
            if (typeof str !== 'string') return '';
            return str
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }
    </script>
</body>
</html>
